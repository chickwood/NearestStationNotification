# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# 忽略特定的 YAML 配置文件
/analysis_options.yaml
/devtools_options.yaml
/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android 局部配置与生成的二进制文件
android/**/generated/
android/app/debug
android/app/profile
android/app/release
android/build/
android/.gradle/
android/.kotlin/
android/local.properties
*.keystore
*.jks

# iOS 局部配置
ios/.generated/
ios/Flutter/.last_build_id
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Podfile.lock

# 忽略根目录下的临时文档
/*.docx
/*.doc
/*.pdf
/*.odt
/*.geojson

# 忽略根目录下的非 assets 图片
/*.png
/*.jpg
/*.jpeg
/*.pdn

# 忽略本地日志或临时导出文件
/*.log
/*.7z
/*.zip
/*.rar

**/*.bak.*
**/*.old.*
**/*.bak
**/*.old

# Widget Preview related
.widget_preview/

